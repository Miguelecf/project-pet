# Supabase — credenciales públicas del proyecto
# Copiá este archivo a .env y completá con tus valores reales.
# El archivo .env está en .gitignore y NUNCA se commitea.

# URL del proyecto Supabase (encontrala en Settings → API → Project URL)
# IMPORTANTE: sin path al final. Solo el origen (https://xxxx.supabase.co).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (encontrala en Settings → API → Project API keys → publishable)
# Esta key es segura para exponer en el frontend. La service_role key NUNCA debe estar acá.
# (También aceptamos VITE_SUPABASE_ANON_KEY por compatibilidad con setups viejos.)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
