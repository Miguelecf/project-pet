# Supabase — credenciales públicas del proyecto
# Copiá este archivo a .env y completá con tus valores reales.
# El archivo .env está en .gitignore y NUNCA se commitea.

# URL del proyecto Supabase (encontrala en Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon public key (encontrala en Settings → API → Project API keys → anon public)
# Esta key es segura para exponer en el frontend. La service_role key NUNCA debe estar acá.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
